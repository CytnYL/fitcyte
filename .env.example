# Copy this file to .env.local and fill in your real values.
# .env.local is already git-ignored — never commit real keys.

# Supabase project -> Settings -> API Keys -> "Publishable and secret
# API keys" tab. Find your Project URL on that same page.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Starts with sb_publishable_... (older projects may instead show a
# legacy "anon" key under the "Legacy API Keys" tab — that works too).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Used to build absolute links (e.g. email confirmation redirects).
# Localhost while developing; your real Vercel URL in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# NOT used yet in Phase 1. The secret key (starts with sb_secret_...;
# legacy projects call this the service_role key) bypasses Row Level
# Security entirely, so it must never be exposed to the browser and
# must never be prefixed with NEXT_PUBLIC_. Only add it later if a
# specific server-only feature (e.g. admin tooling) needs it.
# SUPABASE_SECRET_KEY=

# NOT used yet — wired up in the AI Shoot Assistant phase.
# GEMINI_API_KEY=
